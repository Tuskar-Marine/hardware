	(text "Notes:\n* C1 is a 1kV part for ESD protection\n* +12V / GND may come from alternate source"
		(exclude_from_sim no)
		(at 51.816 17.272 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "24d5f87f-4f40-4fbb-8a8e-f5932cac1e06")
	)
	(text "M12, 5-pin, A-Coded Pinout:\n(NMEA2000 Connector)\n==================\n1. Shield\n2. +12V\n3. GND\n4. CAN_H\n5. CAN_L\n6. Shell\n==================\nColours for Amphenol MSAS-05PMMC-SF8C15\n* Tie M12 shell to ship's ground for ESD"
		(exclude_from_sim no)
		(at 51.562 36.576 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "32b2704d-c6a0-4ba8-ab65-ec790c1f26ea")
	)
	(text "Future revision will add a Q2-short detector with fail-safe /BW_OK output.\nE2.5 will carry the net when that feature is added, allowing current parent \nboards to drop in the new board and enable the monitoring in their firmware.\n* See 'docs/FUTURE-REV.md' for details."
		(exclude_from_sim no)
		(at 16.002 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3555f5d4-5a3f-497a-9352-c72408674a1e")
	)
